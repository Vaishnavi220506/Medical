# Copy this file to .env and fill in your key.
# Get an API key at https://console.anthropic.com/
# Choose "ollama" for a free local model, or "anthropic" for Claude.
ONCOVISION_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ONCOVISION_OLLAMA_MODEL=llama3.2
# Set true only when the selected Ollama model supports images (for example, a vision model).
ONCOVISION_OLLAMA_VISION=false
# OLLAMA_HOST=http://127.0.0.1:11434

# Optional settings
# ONCOVISION_LLM_MODEL=claude-opus-5-5
# ONCOVISION_DEVICE=auto          # auto | cpu | cuda | mps
# ONCOVISION_MC_SAMPLES=8         # Monte-Carlo dropout passes (lower = faster on CPU)
# ONCOVISION_REVIEW_THRESHOLD=      # override boundary uncertainty that triggers review (default: per scan type)
# ONCOVISION_MIN_CONFIDENCE=0.70
# ONCOVISION_MAX_MC_STD=0.08
# ONCOVISION_DATA_DIR=./data
# ONCOVISION_WEIGHTS_DIR=./weights
