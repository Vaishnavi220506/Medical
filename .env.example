# Copy this file to .env and fill in your key.
# Get an API key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional settings
# ONCOVISION_LLM_MODEL=claude-opus-5-5
# ONCOVISION_DEVICE=auto          # auto | cpu | cuda | mps
# ONCOVISION_MC_SAMPLES=8         # Monte-Carlo dropout passes (lower = faster on CPU)
# ONCOVISION_REVIEW_THRESHOLD=0.45  # boundary uncertainty that triggers expert review
# ONCOVISION_MIN_CONFIDENCE=0.70
# ONCOVISION_MAX_MC_STD=0.05
# ONCOVISION_DATA_DIR=./data
# ONCOVISION_WEIGHTS_DIR=./weights
